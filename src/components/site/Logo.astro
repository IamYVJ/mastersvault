---
// Vault-door mark. Uses currentColor-free tokens so it follows the theme.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect x="1" y="1" width="30" height="30" rx="8" fill="var(--accent)"></rect>
  <circle cx="16" cy="16" r="9" fill="none" stroke="var(--on-accent)" stroke-width="2.2"></circle>
  <circle cx="16" cy="13.6" r="2.6" fill="var(--on-accent)"></circle>
  <path d="M14.6 15.4h2.8l.9 5.4h-4.6z" fill="var(--on-accent)"></path>
</svg>
