---
import { DISCLAIMER, SITE } from '../../lib/site';
import { url } from '../../lib/url';
---

<footer class="site-footer">
  <div class="container">
    <p class="disclaimer">{DISCLAIMER}</p>
    <div class="row">
      <nav aria-label="Footer">
        <a href={url('/about/')}>About</a>
        <a href={url('/disclaimer/')}>Disclaimer</a>
        <a href={url('/privacy/')}>Privacy</a>
        <a href={SITE.repo}>Source on GitHub</a>
      </nav>
      <p class="license">
        © 2026 {SITE.name} contributors · Questions and notes: <a href={url(SITE.contentTermsPath)}>{SITE.contentRights.toLowerCase()}</a> · Code:{' '}
        <a href={SITE.codeLicense.url}>{SITE.codeLicense.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0 44px;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .disclaimer {
    max-width: 84ch;
    margin-bottom: 20px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 28px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  a:hover {
    color: var(--text);
  }
  .license {
    margin: 0;
  }
</style>
