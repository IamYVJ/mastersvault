---
import type { ExamBundle } from '../../lib/content/index.ts';
import type { TestDef } from '../../lib/content/load.ts';
import { url } from '../../lib/url';

interface Props {
  exam: ExamBundle;
  test: TestDef;
}
const { exam, test } = Astro.props;
const questions = test.sections.reduce((n, s) => n + s.questions.length, 0);
const minutes = test.sections.reduce((n, s) => n + s.timeMinutes, 0);
const href = url(`/${exam.id}/${test.kind === 'mock' ? 'mocks' : 'practice'}/${test.id}/`);
const difficulties = test.sections.flatMap((s) => s.questions.map((q) => exam.questions.get(q)!.data.difficulty));
const avg = difficulties.reduce((a, b) => a + b, 0) / difficulties.length;
const level = avg < 2.5 ? 'Easier' : avg < 3.5 ? 'Medium' : 'Harder';
---

<a class="card test-card" href={href}>
  <h3>{test.title}</h3>
  {test.description && <p class="muted small">{test.description}</p>}
  <p class="meta">
    <span class="badge">{questions} questions</span>
    <span class="badge">{minutes} min</span>
    <span class="badge">{level}</span>
  </p>
</a>

<style>
  .test-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .test-card:hover {
    border-color: var(--accent);
    color: inherit;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
  }
</style>
