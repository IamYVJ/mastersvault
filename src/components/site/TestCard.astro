---
import type { ExamBundle } from '../../lib/content/index.ts';
import type { TestDef } from '../../lib/content/load.ts';
import { url } from '../../lib/url';

interface Props {
  exam: ExamBundle;
  test: TestDef;
}
const { exam, test } = Astro.props;
const questions = test.sections.reduce((n, s) => n + s.questions.length, 0);
const minutes = test.sections.reduce((n, s) => n + s.timeMinutes, 0);
const href = url(`/${exam.id}/${test.kind === 'mock' ? 'mocks' : 'practice'}/${test.id}/`);
const difficulties = test.sections.flatMap((s) => s.questions.map((q) => exam.questions.get(q)!.data.difficulty));
const avg = difficulties.reduce((a, b) => a + b, 0) / difficulties.length;
const level = avg < 2.5 ? 'Easier' : avg < 3.5 ? 'Medium' : 'Harder';
---

<li>
  <a class="entry" href={href}>
    <div class="entry-line">
      <h3>{test.title}</h3>
      <span class="leader" aria-hidden="true"></span>
      <span class="entry-meta">
        <span class="count">{questions} questions</span> · <span class="time">{minutes} min</span> · <span class="level">{level}</span>
      </span>
    </div>
    {test.description && <p class="entry-desc">{test.description}</p>}
  </a>
</li>

<style>
  /* Fixed widths, so that the three details line up down the list. */
  @media (min-width: 641px) {
    .count,
    .time,
    .level {
      display: inline-block;
    }
    .count {
      min-width: 12ch;
      text-align: right;
    }
    .time {
      min-width: 7ch;
      text-align: right;
    }
    .level {
      min-width: 6ch;
    }
  }
</style>
