---
import { getExams } from '../../lib/content/index.ts';
import { SITE } from '../../lib/site';
import { url } from '../../lib/url';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (href: string) => path === href.replace(/\/+$/, '') || path.startsWith(href.replace(/\/*$/, '/'));
// With several exams, the header names them, and inside an exam's pages it also links to that
// exam's mocks, practice and revision. With one exam, it links to that exam's pages everywhere.
const exams = getExams();
const current = exams.find((e) => isActive(url(`/${e.id}/`))) ?? (exams.length === 1 ? exams[0] : undefined);
const examLinks = exams.length > 1 ? exams.map((e) => ({ href: url(`/${e.id}/`), label: e.config.name, exam: true })) : [];
const sectionLinks = current
  ? [
      { href: url(`/${current.id}/mocks/`), label: 'Mocks', exam: false },
      { href: url(`/${current.id}/practice/`), label: 'Practice', exam: false },
      { href: url(`/${current.id}/revision/`), label: 'Revision', exam: false },
    ]
  : [];
const links = [...examLinks, ...sectionLinks, { href: url('/dashboard/'), label: 'Dashboard', exam: false }];
// An exam's own link is marked as the current page only on its home page; on its other pages it
// is marked as the current exam.
const state = (l: (typeof links)[number]) =>
  l.exam ? (path === l.href.replace(/\/+$/, '') ? 'page' : isActive(l.href) ? 'true' : undefined) : isActive(l.href) ? 'page' : undefined;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}>
      <Logo />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l, i) => (
            <li class:list={{ 'is-exam': l.exam, 'is-after-exams': !l.exam && i > 0 && links[i - 1].exam }}>
              <a href={l.href} aria-current={state(l)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
      <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
        ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path
          d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path></svg
      >
      <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
        ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
        ></path></svg
      >
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('mv-theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 56px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 0;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'],
  nav a[aria-current='true'] {
    color: var(--text);
    border-bottom-color: var(--text);
  }
  .is-exam a {
    font-weight: 600;
  }
  /* A thin rule between the exams and the current exam's pages. */
  .is-after-exams {
    padding-left: 22px;
    border-left: 1px solid var(--border);
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-right: -7px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--text);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  @media (max-width: 640px) {
    .bar {
      padding-top: 6px;
      gap: 0 8px;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
    }
    nav ul {
      gap: 20px;
    }
    nav a {
      padding: 8px 0 9px;
    }
    .theme-toggle {
      margin-left: auto;
    }
  }
</style>
