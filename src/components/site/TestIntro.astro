---
import type { ExamBundle } from '../../lib/content/index.ts';
import type { TestDef } from '../../lib/content/load.ts';
import { url } from '../../lib/url';

interface Props {
  exam: ExamBundle;
  test: TestDef;
}
const { exam, test } = Astro.props;
const { config } = exam;
const rows = test.sections.map((s) => ({ ...s, config: config.sections.find((c) => c.id === s.id)! }));
const minutes = rows.reduce((n, s) => n + s.timeMinutes, 0);
const kindPath = test.kind === 'mock' ? 'mocks' : 'practice';
const listHref = url(`/${exam.id}/${kindPath}/`);
const takeHref = url(`/${exam.id}/${kindPath}/${test.id}/take/`);
const testKey = `${exam.id}/${kindPath}/${test.id}`;
---

<div class="container page">
  <p class="small"><a href={listHref}>← {test.kind === 'mock' ? 'All mocks' : 'All practice sets'}</a></p>
  <header class="page-head">
    <p class="eyebrow">{config.name} · {test.kind === 'mock' ? 'Mock test' : 'Practice set'}</p>
    <h1>{test.title}</h1>
    {test.description && <p>{test.description}</p>}
  </header>

  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th scope="col">Section</th>
          <th scope="col" class="num">Questions</th>
          <th scope="col" class="num">Time</th>
          <th scope="col">On-screen tools</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((s) => (
            <tr>
              <td>{s.config.name}</td>
              <td class="num">{s.questions.length}</td>
              <td class="num">{s.timeMinutes} min</td>
              <td>{s.config.tools.length ? s.config.tools.map((x) => x[0].toUpperCase() + x.slice(1)).join(', ') : 'None'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="start" data-test-key={testKey} data-take={takeHref}>
    <a class="btn btn-primary" href={takeHref} data-role="primary">Start ({minutes} min)</a>
    <a class="btn" href={`${takeHref}?new`} data-role="restart" hidden>Start over</a>
    <p class="muted small" data-role="status">
      {
        test.kind === 'mock'
          ? 'Opens the full-screen test. Set aside the full time and take it in one sitting.'
          : 'Opens the full-screen test. You can choose timed or untimed on the next screen.'
      }
    </p>
  </div>
</div>

<style>
  .start {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .start p {
    margin: 0;
  }
  .start p[data-role='status'] {
    flex-basis: 100%;
  }
</style>

<script>
  // Offer to resume an unfinished attempt (or reopen the last results) saved in this browser.
  for (const box of document.querySelectorAll<HTMLElement>('.start[data-test-key]')) {
    let saved: { phase?: string; createdAt?: number; finishedAt?: number | null } | null = null;
    try {
      saved = JSON.parse(localStorage.getItem(`mv:attempt:${box.dataset.testKey}`) ?? 'null');
    } catch {
      saved = null;
    }
    if (!saved?.phase || saved.phase === 'setup') continue;
    const primary = box.querySelector<HTMLAnchorElement>('[data-role="primary"]')!;
    const restart = box.querySelector<HTMLAnchorElement>('[data-role="restart"]')!;
    const status = box.querySelector<HTMLElement>('[data-role="status"]')!;
    const when = (t?: number | null) =>
      t ? new Date(t).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : 'earlier';
    restart.hidden = false;
    if (saved.phase === 'results') {
      primary.textContent = 'View last results';
      restart.textContent = 'Take it again';
      status.textContent = `You finished this test on ${when(saved.finishedAt)}.`;
    } else {
      primary.textContent = 'Resume';
      status.textContent = `You have an unfinished attempt from ${when(saved.createdAt)}. The timer was paused when you left.`;
      restart.addEventListener('click', (e) => {
        if (!confirm('Discard your unfinished attempt and start again?')) e.preventDefault();
      });
    }
  }
</script>
