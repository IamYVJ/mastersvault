---
import Base from '../../layouts/Base.astro';
import { getExam, listExamIds } from '../../lib/content/index.ts';
import { TYPE_LABELS } from '../../lib/content/labels.ts';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return listExamIds().map((exam) => ({ params: { exam } }));
}

const exam = getExam(Astro.params.exam);
const { config } = exam;
const totalQuestions = config.sections.reduce((n, s) => n + s.questionCount, 0);
const totalMinutes = config.sections.reduce((n, s) => n + s.timeMinutes, 0);
const hours = `${Math.floor(totalMinutes / 60)} h ${totalMinutes % 60} min`;
const r = config.rules;
---

<Base title={`${config.name} prep`} description={config.description}>
  <div class="container page">
    <header class="page-head">
      <p class="eyebrow">{config.name}</p>
      <h1>{config.name} practice</h1>
      <p>{config.description}</p>
    </header>

    <h2 class="visually-hidden">Practice and revision</h2>
    <div class="grid">
      <a class="card link-card" href={url(`/${exam.id}/mocks/`)}>
        <h3>Mock tests</h3>
        <p class="muted small">
          Full-length, timed, {totalQuestions} questions over {hours}.{' '}
          {exam.mocks.length ? `${exam.mocks.length} available.` : 'Coming soon.'}
        </p>
      </a>
      <a class="card link-card" href={url(`/${exam.id}/practice/`)}>
        <h3>Section practice</h3>
        <p class="muted small">Shorter sets by section and topic. {exam.practice.length} available.</p>
      </a>
      <a class="card link-card" href={url(`/${exam.id}/revision/`)}>
        <h3>Revision</h3>
        <p class="muted small">Concept notes, formula sheets and strategy for every topic.</p>
      </a>
    </div>

    <section class="section">
      <h2>Exam format</h2>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Exam format by section">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">Section</th>
              <th scope="col" class="num">Questions</th>
              <th scope="col" class="num">Time</th>
              <th scope="col">Question types</th>
              <th scope="col">Score range</th>
            </tr>
          </thead>
          <tbody>
            {
              config.sections.map((s) => (
                <tr>
                  <td>
                    <strong>{s.name}</strong>
                    <div class="muted small">{s.description}</div>
                  </td>
                  <td class="num">{s.questionCount}</td>
                  <td class="num">{s.timeMinutes} min</td>
                  <td>{s.questionTypes.map((t) => TYPE_LABELS[t]).join(', ')}</td>
                  <td>
                    {s.score.min}–{s.score.max}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="muted small" style="margin-top: 16px">
        Total: {totalQuestions} questions in {hours}, with a total score of {config.totalScore.min}–{
          config.totalScore.max
        }. Scores shown on MastersVault are unofficial estimates.
      </p>
    </section>

    <section class="section prose">
      <h2>How the test screen works</h2>
      <ul>
        {r.sectionOrder === 'choose' && <li>You choose the order of the three sections before you start.</li>}
        <li>Each section has its own timer. When time runs out, the section ends.</li>
        {r.requireAnswerToAdvance && <li>You must answer each question before moving to the next one.</li>}
        {!r.allowBackNavigation && r.bookmarks && <li>You can't go back mid-section, but you can bookmark questions to revisit.</li>}
        {
          r.reviewAndEdit.enabled && (
            <li>
              If time remains after the last question, you can review your answers and change up to{' '}
              {r.reviewAndEdit.maxAnswerChanges} of them.
            </li>
          )
        }
        {
          r.optionalBreak && (
            <li>
              You can take one optional {r.optionalBreak.minutes}-minute break after section{' '}
              {r.optionalBreak.allowedAfterSection.join(' or ')}.
            </li>
          )
        }
        <li>An on-screen calculator is available only in the section that allows one.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
</style>
