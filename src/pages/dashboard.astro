---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Dashboard" description="Your attempts and progress, stored only in this browser.">
  <div class="container page">
    <header class="page-head">
      <h1>Dashboard</h1>
      <p>
        Your attempts, scores and topic breakdowns will appear here. Everything stays in this browser: there are no
        accounts, and nothing is sent to a server. You'll be able to export and import your history as a file.
      </p>
    </header>
    <div class="notice">
      <p style="margin: 0">
        No attempts yet. Start with a <a href={url('/gmat/practice/')}>practice set</a>.
      </p>
    </div>
  </div>
</Base>
