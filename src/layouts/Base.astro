---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400-italic.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { SITE } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Hide the site header and footer (used by the full-screen test player). */
  bare?: boolean;
  noindex?: boolean;
  /** Structured data (schema.org) describing the page, for search engines. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.description, bare = false, noindex = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url('/og.png'), Astro.site);
const structured = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/icon-180.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    {/* "noai" and the TDM reservation ask crawlers not to use the content for AI training or data mining. */}
    <meta name="robots" content={noindex ? 'noindex, noai, noimageai' : 'noai, noimageai'} />
    <meta name="tdm-reservation" content="1" />
    {!noindex && <link rel="sitemap" href={url('/sitemap.xml')} />}

    {/* Link previews on social media and in messaging apps */}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      // "<" is escaped so that text in the data can never close the script element early.
      structured.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }
    {
      import.meta.env.PROD && (
        <script is:inline define:vars={{ worker: url('/sw.js'), scope: url('/') }}>
          // Offline support. See src/service-worker.js.
          if ('serviceWorker' in navigator) navigator.serviceWorker.register(worker, { scope }).catch(() => {});
        </script>
      )
    }
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem('mv-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class:list={{ bare }}>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a class="skip-link" href="#main">Skip to content</a>
          <Header />
          <main id="main" tabindex="-1">
            <slot />
          </main>
          <Footer />
        </>
      )
    }
    {/* GoatCounter pageview beacon. One GoatCounter site is shared across projects on purpose:
        counts are kept per path, and this site's paths all start with its own base. */}
    <script is:inline data-goatcounter="https://yvj.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
